(* Simple Agitated Mixing Tank with Heater Coil *)

PROGRAM main
  VAR
    InletValve1 : BOOL AT %QX0.1; (* Output Device for Material A Intake *)
    InletValve2 : BOOL AT %QX0.2; (* Output Device for Material B Intake *)
    OutletValve : BOOL AT %QX0.6;
    Start : BOOL AT %IX0.1; (* Simple Push Button Input *)
    Stop : BOOL AT %IX0.2; (* Simple Push Button Input *)
    CycleOn : BOOL AT %QX0.3;
    LevelSensor1 : BOOL AT %IX0.4; (* Upper Level Sensor *)
    LevelSensor2 : BOOL AT %IX0.5;
    LowLevelSensor : BOOL AT %IX0.6; (* Tank Empty Sensor *)
    AgitatorMotor : BOOL AT %QX0.4; (* Actuator for Mixing Materials *)
    Heater : BOOL AT %QX0.5;
    Flag : BOOL AT %MX0.1;
    TemperatureSensor : INT AT %IW1;
    TP0 : TP;
  END_VAR

