(* Single Vertical Tank with Operator Control Panel *)

PROGRAM main
  VAR
    TLB1 : BOOL AT %IX0.1; (* Upper Binary Tank Level Sensor *)
    TLB2 : BOOL AT %IX0.2; (* Lower Binary Tank Level Sensor *)
    MV1 : BOOL AT %QX0.1;
    MV2 : BOOL AT %QX0.2; (* Outlet Valve *)
    Start : BOOL AT %IX1.0;
    Stop : BOOL AT %IX1.1;
    CycleOn : BOOL AT %QX1.0; (* Simple Lamp Indicating Cycle *)
    Buzzer : BOOL AT %QX1.1;
    SR0 : SR;
    SR1 : SR;
  END_VAR

