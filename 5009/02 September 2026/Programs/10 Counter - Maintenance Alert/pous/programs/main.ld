(* Blister Pack Counter to Target *)

PROGRAM main
  VAR
    FaultEvent : BOOL AT %IX0.3 := 125; (* Various Fault Event Placeholder *)
    Reset : BOOL AT %IX0.1; (* Internal Reset or External Reset of Counter *)
    MaintenanceAlert : BOOL AT %QX0.2; (* Detection of Too Many Faults *)
    Force : BOOL AT %QX0.3; (* Force Reset of Maintenance Alert *)
    Counter : INT; (* Pill Count Variable for SCADA *)
    CTU0 : CTU;
    TOF0 : TOF;
    SR0 : SR;
  END_VAR

