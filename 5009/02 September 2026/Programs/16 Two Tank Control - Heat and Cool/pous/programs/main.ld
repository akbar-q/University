(* Two Tank Control, One Heating, One Cooling *)

PROGRAM main
  VAR
    Start : BOOL AT %IX0.0; (* Simple Push Button Input *)
    Stop : BOOL AT %IX0.1; (* Simple Push Button Input *)
    LevelSensor1 : BOOL AT %IX0.2;
    LevelSensor2 : BOOL AT %IX0.3; (* Tank 1 Sensor *)
    LevelSensor3 : BOOL AT %IX0.4; (* Tank 2 Sensor *)
    LevelSensor4 : BOOL AT %IX0.5; (* Tank 2 Sensor *)
    CycleOn : BOOL AT %QX0.0; (* Internal Variable / Output Lamp *)
    InletValve : BOOL AT %QX0.1; (* Main Inlet Valve Shared by 2 Tanks *)
    Valve2 : BOOL AT %QX0.2; (* Auxiliary Valve *)
    Valve3 : BOOL AT %QX0.7; (* Auxiliary Valve *)
    OutletValve1 : BOOL AT %QX0.3; (* Tank 1 Outlet Valve *)
    OutletValve2 : BOOL AT %QX0.4; (* Tank 2 Outlet Valve *)
    Heater : BOOL AT %QX0.5; (* Tank 1 Heater *)
    Cooler : BOOL AT %QX0.6; (* Tank 2 Cooling Water Flow *)
    TempSensor1 : INT AT %IW1; (* Tank 1 Analog Temperature Sensor *)
    TempSensor2 : INT AT %IW2; (* Tank 2 Analog Temperature Sensor *)
  END_VAR

